# ─────────────────────────────────────────────────────────────────────────────
# Diwar-e-Faiz environment variables
# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Firebase WEB app config (public, sent to the browser) ─────────────────
# Firebase console → Project settings → General → Your apps → Web app → "SDK setup and configuration".
# These identify your project; security comes from Firestore/Storage rules, not from hiding them.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 2. Firebase ADMIN service account (SECRET, server only) ──────────────────
# Firebase console → Project settings → Service accounts → "Generate new private key".
# Copy project_id, client_email and private_key from the downloaded JSON.
# Keep the private key in double quotes with literal \n line breaks, exactly as in the JSON.
# NEVER prefix these with NEXT_PUBLIC_ and never commit the JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional — defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
FIREBASE_STORAGE_BUCKET=

# ── 3. Local emulators (optional, for development/testing only) ──────────────
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
